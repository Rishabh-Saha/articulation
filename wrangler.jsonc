{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "articulation",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  // Preserve variables already entered in the Cloudflare dashboard.
  // Secrets such as GEMINI_API_KEY stay in Cloudflare, never in this file.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  // Preserve D1 bindings already configured in the dashboard on code updates.
  // These supported upload metadata fields avoid inventing a database ID.
  "unsafe": {
    "metadata": {
      "keep_bindings": ["plain_text", "json", "secret_text", "secret_key", "d1"],
    },
  },
}
