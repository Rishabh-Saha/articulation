{
  "name": "articulation-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:worker": "npm run build && wrangler deploy --dry-run --outdir .wrangler/build",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:worker": "node tests/worker-smoke.mjs",
    "test:rules": "node tests/rules.mjs",
    "test:e2e": "node tests/smoke.mjs",
    "test:cloud": "node tests/cloud-smoke.mjs",
    "test:a11y": "node tests/accessibility.mjs",
    "test:safety": "node tests/safety-smoke.mjs",
    "setup:emulators": "python3 scripts/setup-emulator.py",
    "emulators": "node scripts/emulators.mjs",
    "dev:cloud-test": "VITE_FIREBASE_API_KEY=demo-key VITE_FIREBASE_AUTH_DOMAIN=demo-articulation.firebaseapp.com VITE_FIREBASE_PROJECT_ID=demo-articulation VITE_FIREBASE_APP_ID=demo-app VITE_FIREBASE_EMULATORS=1 vite --host 127.0.0.1 --port 5174"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  }
}
